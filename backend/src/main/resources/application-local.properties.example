# Example local development configuration
spring.datasource.url=jdbc:mysql://localhost:3306/resolveit_simple_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_PASSWORD
app.jwt.secret=change-this-to-a-very-secure-at-least-32-character-secret-key-12345

app.seed.enabled=true
app.seed.demo-password=DemoPassword123
